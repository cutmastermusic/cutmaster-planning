# Database (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Auth (required for magic-link login)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase service role (required for welcome photo uploads to Storage)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Canonical site URL for magic-link redirects (required in production)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth mode: hybrid | prototype | supabase (default: hybrid)
# hybrid    — magic link + prototype role picker
# prototype — prototype role picker only (when Supabase env is missing or for local dev)
# supabase  — magic link only
NEXT_PUBLIC_AUTH_MODE="hybrid"

# Allow prototype login without Supabase session (local dev only — never set in production)
AUTH_BYPASS="true"

# Optional: Next.js dev LAN origins (see README)
# NEXT_DEV_ALLOWED_ORIGINS="10.0.0.5"
