generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  events Event[]
}

model Event {
  id        String   @id @default(cuid())
  title     String
  date      DateTime?
  type      String?
  venue     String?

  assignedDj        String?
  packageName       String?
  plannerName       String?
  plannerEmail      String?
  ceremonyLocation  String?
  receptionLocation String?
  internalNotes     String?

  ownerId String
  owner   User @relation(fields: [ownerId], references: [id])

  timelines Timeline[]
  songs EventSong[]

  createdAt DateTime @default(now())
}

model Timeline {
  id      String @id @default(cuid())
  title   String

  eventId String
  event   Event @relation(fields: [eventId], references: [id])

  items TimelineItem[]

  @@unique([eventId, title])
}

model TimelineItem {
  id    String @id @default(cuid())

  time     String?
  title    String
  category String?
  notes    String?

  needsDjMcAttention Boolean @default(false)

  songTitle String?
  artist    String?

  fadeOutEarly     Boolean @default(false)
  fadeOutTimestamp String?

  order Int

  timelineId String
  timeline   Timeline @relation(fields: [timelineId], references: [id])
}

model EventSong {
  id String @id @default(cuid())

  listType String

  title  String
  artist String?
  notes  String?

  highPriority Boolean @default(false)

  order Int

  eventId String
  event   Event @relation(fields: [eventId], references: [id])
}