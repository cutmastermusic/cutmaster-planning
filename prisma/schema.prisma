generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  events Event[]
  companyTeamMembers CompanyTeamMember[]
}

model CompanyTeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  order     Int

  ownerId String
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Event {
  id        String   @id @default(cuid())
  title     String
  date      DateTime?
  type      String?
  venue     String?
  venueAddress String?

  assignedDj        String?
  packageName       String?
  plannerName       String?
  plannerEmail      String?
  ceremonyLocation  String?
  receptionLocation String?
  internalNotes     String?
  eventStatus       String   @default("Planning")

  /** DB-backed Grand Entrance moment detail (syncs across devices). */
  grandEntranceScript  String?
  grandEntranceLineup  String?
  grandEntranceCouple  String?

  /** DB-backed planning questionnaire answers (pq_* / ge_* keys). */
  planningQuestionAnswers Json?
  /** DB-backed ceremony planning fields (times, notes, processional songs). */
  ceremonyPlan            Json?
  /** DB-backed DJ-only operational scripts (Show Book). Not client-facing. */
  djScripts               Json?

  ownerId String
  owner   User @relation(fields: [ownerId], references: [id])

  timelines Timeline[]
  songs EventSong[]
  guestRequests GuestRequest[]
  eventTeamMembers EventTeamMember[]
  eventNotes EventNote[]

  createdAt DateTime @default(now())
}

model Timeline {
  id      String @id @default(cuid())
  title   String

  eventId String
  event   Event @relation(fields: [eventId], references: [id])

  items TimelineItem[]

  @@unique([eventId, title])
}

model TimelineItem {
  id    String @id @default(cuid())

  time     String?
  title    String
  category String?
  notes    String?

  needsDjMcAttention Boolean @default(false)

  songTitle String?
  artist    String?

  fadeOutEarly     Boolean @default(false)
  fadeOutTimestamp String?

  /** Run Of Show execution: moment marked complete/crossed off (DB-backed). */
  runOfShowDone Boolean @default(false)

  /** How the Shared Team Cue (notes) renders in Run Of Show: plain | bullets | numbered. */
  teamCueFormat String? @default("plain")

  order Int

  timelineId String
  timeline   Timeline @relation(fields: [timelineId], references: [id])
}

model EventSong {
  id String @id @default(cuid())

  listType String

  title  String
  artist String?
  notes  String?

  highPriority Boolean @default(false)

  order Int

  eventId String
  event   Event @relation(fields: [eventId], references: [id])
}

model GuestRequest {
  id String @id @default(cuid())

  guestName  String
  songTitle  String
  artist     String
  dedication String
  status     String

  addedToMustPlay  Boolean @default(false)
  addedToDoNotPlay Boolean @default(false)

  order Int

  eventId String
  event   Event @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventTeamMember {
  id String @id @default(cuid())

  name    String
  role    String
  company String?
  email   String?
  phone   String?
  notes   String?

  website                  String?
  instagram                String?
  arrivalTime              String?
  specialCoordinationNotes String?

  isActive       Boolean @default(true)
  isCollaborator Boolean @default(false)
  permissions    Json?

  order Int

  eventId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model EventNote {
  id String @id @default(cuid())

  category String @default("General")
  title    String?
  body     String
  isPinned Boolean @default(false)

  order Int

  eventId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}