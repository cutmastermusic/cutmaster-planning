generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Cutmaster platform identity — not event-scoped role.
enum PlatformRole {
  ADMIN
  STAFF
}

/// Role on a specific event.
enum EventMemberRole {
  COUPLE
  DJ
  PLANNER
  ADMIN
}

enum EventMemberStatus {
  PENDING
  ACTIVE
  REVOKED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  authSubject  String?       @unique @db.Uuid
  platformRole PlatformRole?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  events                 Event[]
  companyTeamMembers     CompanyTeamMember[]
  eventMembers           EventMember[]
  eventMembersInvited    EventMember[]       @relation("EventMemberInvitedBy")
  invitesCreated         EventInvite[]       @relation("InviteCreatedBy")

  @@index([platformRole])
}

model CompanyTeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  email     String?
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  order     Int

  ownerId String
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Event {
  id        String   @id @default(cuid())
  title     String
  date      DateTime?
  type      String?
  venue     String?
  venueAddress String?

  assignedDj        String?
  packageName       String?
  plannerName       String?
  plannerEmail      String?
  ceremonyLocation  String?
  receptionLocation String?
  internalNotes     String?
  eventStatus       String   @default("Planning")

  /** DB-backed Grand Entrance moment detail (syncs across devices). */
  grandEntranceScript  String?
  grandEntranceLineup  String?
  grandEntranceCouple  String?

  /** DB-backed planning questionnaire answers (pq_* / ge_* keys). */
  planningQuestionAnswers Json?
  /** DB-backed ceremony planning fields (times, notes, processional songs). */
  ceremonyPlan            Json?
  /** DB-backed Music Hub taste / genre / vibe selections. */
  musicHubPlan            Json?
  /** DB-backed DJ-only operational scripts (Show Book). Not client-facing. */
  djScripts               Json?
  /** DB-backed DJ-only operational music notes (Show Book). Not client-facing. */
  djMusicNotes            Json?

  ownerId String
  owner   User @relation(fields: [ownerId], references: [id])

  timelines Timeline[]
  songs EventSong[]
  guestRequests GuestRequest[]
  eventTeamMembers EventTeamMember[]
  eventNotes EventNote[]
  members EventMember[]
  invites EventInvite[]

  createdAt DateTime @default(now())
}

model EventMember {
  id          String            @id @default(cuid())
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  email       String
  displayName String?

  role        EventMemberRole
  status      EventMemberStatus @default(PENDING)

  invitedById String?
  invitedBy   User?             @relation("EventMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  invitedAt   DateTime          @default(now())
  acceptedAt  DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  invites     EventInvite[]

  @@unique([eventId, email])
  @@index([eventId, status])
  @@index([userId])
  @@index([email])
}

model EventInvite {
  id            String          @id @default(cuid())
  eventId       String
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  eventMemberId String?
  eventMember   EventMember?    @relation(fields: [eventMemberId], references: [id], onDelete: SetNull)

  email         String
  role          EventMemberRole

  tokenHash     String          @unique

  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?

  createdById   String?
  createdBy     User?           @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([eventId])
  @@index([email])
  @@index([expiresAt])
}

model Timeline {
  id      String @id @default(cuid())
  title   String

  eventId String
  event   Event @relation(fields: [eventId], references: [id])

  items TimelineItem[]

  @@unique([eventId, title])
}

model TimelineItem {
  id    String @id @default(cuid())

  time     String?
  title    String
  category String?
  notes    String?

  needsDjMcAttention Boolean @default(false)

  songTitle String?
  artist    String?

  fadeOutEarly     Boolean @default(false)
  fadeOutTimestamp String?

  /** Run Of Show execution: moment marked complete/crossed off (DB-backed). */
  runOfShowDone Boolean @default(false)

  /** How the Shared Team Cue (notes) renders in Run Of Show: plain | bullets | numbered. */
  teamCueFormat String? @default("plain")

  order Int

  timelineId String
  timeline   Timeline @relation(fields: [timelineId], references: [id])
}

model EventSong {
  id String @id @default(cuid())

  listType String

  title  String
  artist String?
  notes  String?

  highPriority Boolean @default(false)

  order Int

  eventId String
  event   Event @relation(fields: [eventId], references: [id])
}

model GuestRequest {
  id String @id @default(cuid())

  guestName  String
  songTitle  String
  artist     String
  dedication String
  status     String

  addedToMustPlay  Boolean @default(false)
  addedToDoNotPlay Boolean @default(false)

  order Int

  eventId String
  event   Event @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventTeamMember {
  id String @id @default(cuid())

  name    String
  role    String
  company String?
  email   String?
  phone   String?
  notes   String?

  website                  String?
  instagram                String?
  arrivalTime              String?
  specialCoordinationNotes String?

  isActive       Boolean @default(true)
  isCollaborator Boolean @default(false)
  permissions    Json?

  order Int

  eventId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model EventNote {
  id String @id @default(cuid())

  category String @default("General")
  title    String?
  body     String
  isPinned Boolean @default(false)

  order Int

  eventId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}
